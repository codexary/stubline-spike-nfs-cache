FROM debian:12.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends nfs-kernel-server nfs-common rpcbind && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /data /run/rpcbind /proc/fs/nfsd && printf '/data *(rw,sync,no_subtree_check,no_root_squash,fsid=0,insecure)\n' > /etc/exports
COPY scripts/start-server.sh /usr/local/bin/start-server
RUN chmod +x /usr/local/bin/start-server
CMD ["/usr/local/bin/start-server"]
